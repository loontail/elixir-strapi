{
  "kind": "collectionType",
  "collectionName": "bundle_registry_artifacts",
  "info": {
    "singularName": "artifact",
    "pluralName": "artifacts",
    "displayName": "Artifact",
    "description": "Individual file within a build"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "build": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::bundle-registry.build",
      "inversedBy": "artifacts"
    },
    "relativePath": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string"
    },
    "size": {
      "type": "biginteger",
      "default": "0"
    },
    "sha256": {
      "type": "string"
    },
    "isDir": {
      "type": "boolean",
      "default": false
    },
    "downloadOnce": {
      "type": "boolean",
      "default": false
    },
    "fileModifiedAt": {
      "type": "datetime"
    }
  }
}
