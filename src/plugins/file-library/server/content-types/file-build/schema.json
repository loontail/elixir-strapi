{
  "kind": "collectionType",
  "collectionName": "file_builds",
  "info": {
    "singularName": "file-build",
    "pluralName": "file-builds",
    "displayName": "File Build",
    "description": "File build with artifact manifest"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": { "visible": true },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "processing", "ready", "failed"],
      "default": "draft"
    },
    "filesCount": {
      "type": "integer",
      "default": 0
    },
    "totalSize": {
      "type": "biginteger",
      "default": "0"
    },
    "processingError": {
      "type": "text"
    },
    "lastGeneratedAt": {
      "type": "datetime"
    },
    "fileEntries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::file-library.file-entry",
      "mappedBy": "build"
    }
  }
}
